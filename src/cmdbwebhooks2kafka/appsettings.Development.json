{
  "Service": {
    "Name": "cmdbwebhooks2kafka-dev",
    "HealthRoute": "/health"
  },
  "Transport": {
    "Mode": "Http"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DebugLogging": {
    "Enabled": false,
    "Level": "Basic"
  },
  "CmdbWebhook": {
    "AuthorizationMode": "Disabled",
    "BearerToken": "",
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "cmdbuild.webhooks.dev",
    "ClientId": "cmdbwebhooks2kafka-dev",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "",
    "Username": "",
    "Password": ""
  },
  "ElkLogging": {
    "Enabled": true,
    "Mode": "Kafka",
    "Elk": {
      "Enabled": false,
      "Endpoint": "",
      "Index": "cmdbwebhooks2kafka-logs-dev",
      "ApiKey": ""
    },
    "Kafka": {
      "Enabled": true,
      "BootstrapServers": "localhost:9092",
      "Topic": "cmdbwebhooks2kafka.logs.dev",
      "ClientId": "cmdbwebhooks2kafka-logs-dev",
      "SecurityProtocol": "Plaintext",
      "SaslMechanism": "",
      "Username": "",
      "Password": "",
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageTimeoutMs": 30000,
      "MinimumLevel": "Information",
      "ServiceName": "cmdbwebhooks2kafka",
      "Environment": "Development",
      "FlushTimeoutMs": 5000
    }
  }
}
