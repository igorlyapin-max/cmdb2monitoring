{
  "Service": {
    "Name": "monitoring-ui-api",
    "Host": "0.0.0.0",
    "Port": 5090,
    "HealthRoute": "/health",
    "PublicDir": "public"
  },
  "Transport": {
    "Mode": "Http",
    "AllowPlainHttp": false,
    "Certificate": {
      "Path": "",
      "KeyPath": "",
      "Password": ""
    }
  },
  "Secrets": {
    "Provider": "None",
    "References": {},
    "IndeedPamAapm": {
      "BaseUrl": "",
      "PasswordEndpointPath": "/sc_aapm_ui/rest/aapm/password",
      "ApplicationToken": "",
      "ApplicationTokenFile": "",
      "ApplicationUsername": "",
      "ApplicationPassword": "",
      "DefaultAccountPath": "",
      "SendApplicationCredentialsInQuery": false,
      "ResponseType": "json",
      "ValueJsonPath": "password",
      "PasswordExpirationInMinute": "30",
      "PasswordChangeRequired": false,
      "Comment": "cmdb2monitoring {service} {secretId}",
      "TenantId": "",
      "TimeoutMs": 10000
    }
  },
  "UiSettings": {
    "FilePath": "state/ui-settings.json"
  },
  "Auth": {
    "UseIdp": false,
    "UsersFilePath": "state/users.json",
    "SessionCookieName": "cmdb2m_session",
    "SessionTimeoutMinutes": 60,
    "SessionAbsoluteLifetimeMinutes": 480,
    "RequestStateTimeoutSeconds": 600,
    "SecureCookies": false,
    "SessionEncryptionKey": "",
    "SessionStore": {
      "Mode": "Memory",
      "KeyPrefix": "cmdb2m",
      "Redis": {
        "Url": "redis://127.0.0.1:6379/0",
        "Username": "",
        "Password": "",
        "Database": 0,
        "Tls": false,
        "RejectUnauthorized": true,
        "ConnectTimeoutMs": 5000
      }
    },
    "MaxSamlPostBytes": 1048576,
    "EmergencyLocalLoginEnabled": true
  },
  "RateLimit": {
    "Enabled": true,
    "WindowSeconds": 60,
    "AuthPermitLimit": 60,
    "ApiPermitLimit": 600
  },
  "Logging": {
    "MinimumLevel": "Information"
  },
  "DebugLogging": {
    "Enabled": false,
    "Level": "Basic"
  },
  "ElkLogging": {
    "Enabled": true,
    "Mode": "Kafka",
    "Elk": {
      "Enabled": false,
      "Endpoint": "",
      "Index": "monitoring-ui-api-logs",
      "ApiKey": ""
    },
    "Kafka": {
      "Enabled": true,
      "BootstrapServers": "localhost:9092",
      "Topic": "monitoring-ui-api.logs",
      "ClientId": "monitoring-ui-api-logs",
      "SecurityProtocol": "Plaintext",
      "AllowPlaintextKafka": false,
      "SaslMechanism": "",
      "Username": "",
      "Password": "",
      "SslCaLocation": "",
      "SslCertificateLocation": "",
      "SslKeyLocation": "",
      "SslRejectUnauthorized": true,
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageTimeoutMs": 30000,
      "MinimumLevel": "Information",
      "ServiceName": "monitoring-ui-api",
      "Environment": "Production",
      "FlushTimeoutMs": 5000
    }
  },
  "Idp": {
    "Provider": "SAML2",
    "Enabled": false,
    "MetadataUrl": "",
    "EntityId": "",
    "SsoUrl": "",
    "SloUrl": "",
    "IdpX509Certificate": "",
    "IdpX509CertificatePath": "",
    "SpEntityId": "cmdb2monitoring-monitoring-ui",
    "AcsUrl": "http://localhost:5090/auth/saml2/acs",
    "SloCallbackUrl": "http://localhost:5090/auth/saml2/logout",
    "SpCertificate": "",
    "SpCertificatePath": "",
    "SpPrivateKey": "",
    "SpPrivateKeyPath": "",
    "NameIdFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
    "AuthnRequestBinding": "HTTP-Redirect",
    "RequireSignedAssertions": true,
    "RequireSignedResponses": false,
    "RequireEncryptedAssertions": false,
    "ClockSkewSeconds": 120,
    "RequestIdExpirationMinutes": 30,
    "MetadataCacheTtlSeconds": 300,
    "SignatureAlgorithm": "sha256",
    "DigestAlgorithm": "sha256",
    "SignMetadata": false,
    "DisableRequestedAuthnContext": false,
    "AttributeMapping": {
      "Login": "uid",
      "Email": "email",
      "DisplayName": "displayName",
      "Groups": "groups"
    },
    "RoleMapping": {
      "Admin": "cmdb2monitoring-admin",
      "Editor": "cmdb2monitoring-editor",
      "Viewer": "cmdb2monitoring-viewer"
    },
    "OAuth2": {
      "AuthorizationUrl": "",
      "TokenUrl": "",
      "UserInfoUrl": "",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:5090/auth/oauth2/callback",
      "Scopes": "openid profile email",
      "LoginClaim": "preferred_username",
      "EmailClaim": "email",
      "DisplayNameClaim": "name",
      "GroupsClaim": "groups"
    },
    "Ldap": {
      "Protocol": "ldap",
      "Host": "",
      "Port": 389,
      "BaseDn": "",
      "BindDn": "",
      "BindPassword": "",
      "UserDnTemplate": "",
      "UserSearchBase": "",
      "UserFilter": "(|(sAMAccountName={login})(userPrincipalName={login})(uid={login}))",
      "GroupSearchBase": "",
      "GroupFilter": "(|(member={dn})(memberUid={login}))",
      "GroupNameAttribute": "cn",
      "LoginAttribute": "sAMAccountName",
      "EmailAttribute": "mail",
      "DisplayNameAttribute": "displayName",
      "GroupsAttribute": "memberOf",
      "TlsRejectUnauthorized": true
    }
  },
  "Cmdbuild": {
    "ApiVersion": "v4",
    "BaseUrl": "http://localhost:8090/cmdbuild/services/rest/v4",
    "Tls": {
      "AllowInsecureHttp": false,
      "RejectUnauthorized": true,
      "CaCertificatePath": "",
      "ClientCertificatePath": "",
      "ClientCertificateKeyPath": ""
    },
    "Webhooks": {
      "AuthorizationHeader": ""
    },
    "Catalog": {
      "CacheFilePath": "data/cmdbuild-catalog-cache.json",
      "CacheTtlSeconds": 3600,
      "SyncOnStartup": false,
      "ValidateRulesAgainstCatalog": true,
      "IncludeInactiveClasses": false,
      "IncludeLookupValues": true,
      "MaxTraversalDepth": 2
    }
  },
  "Zabbix": {
    "ApiEndpoint": "http://localhost:8081/api_jsonrpc.php",
    "ApiToken": "",
    "Tls": {
      "AllowInsecureHttp": false,
      "RejectUnauthorized": true,
      "CaCertificatePath": "",
      "ClientCertificatePath": "",
      "ClientCertificateKeyPath": ""
    },
    "AllowDynamicTagsFromCmdbLeaf": false,
    "AllowDynamicHostGroupsFromCmdbLeaf": false,
    "Catalog": {
      "CacheFilePath": "data/zabbix-catalog-cache.json",
      "CacheTtlSeconds": 3600,
      "SyncOnStartup": false,
      "ValidateRulesAgainstCatalog": true,
      "StrictTagValidation": false,
      "KnownTagsSource": "HostsAndRules"
    }
  },
  "Rules": {
    "ActiveBaseDirectory": "../..",
    "ActiveFilePath": "rules/cmdbuild-to-zabbix-host-create.json",
    "ActiveWriteEnabled": false,
    "ReadFromGit": false,
    "RepositoryUrl": "",
    "RepositoryPath": "rules-git-working-copy",
    "RulesFilePath": "rules/cmdbuild-to-zabbix-host-create.json",
    "MaxUploadBytes": 1048576,
    "AllowUpload": true
  },
  "AuditStorage": {
    "Provider": "postgresql",
    "ConnectionString": "",
    "Schema": "public",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "EventBrowser": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ClientId": "monitoring-ui-api-events",
    "SecurityProtocol": "Plaintext",
    "AllowPlaintextKafka": false,
    "SaslMechanism": "",
    "Username": "",
    "Password": "",
    "SslCaLocation": "",
    "SslCertificateLocation": "",
    "SslKeyLocation": "",
    "SslRejectUnauthorized": true,
    "MaxMessages": 50,
    "ReadTimeoutMs": 2500,
    "Topics": [
      {
        "Name": "cmdbuild.webhooks",
        "Service": "cmdbwebhooks2kafka",
        "Direction": "output",
        "Description": "Normalized CMDBuild webhook events"
      },
      {
        "Name": "zabbix.host.requests",
        "Service": "cmdbkafka2zabbix",
        "Direction": "output",
        "Description": "Zabbix JSON-RPC requests"
      },
      {
        "Name": "zabbix.host.responses",
        "Service": "zabbixrequests2api",
        "Direction": "output",
        "Description": "Zabbix API processing responses"
      },
      {
        "Name": "zabbix.host.bindings",
        "Service": "zabbixrequests2api",
        "Direction": "output",
        "Description": "Zabbix host binding events for CMDBuild back-sync"
      },
      {
        "Name": "cmdbuild.webhooks.dlq",
        "Service": "cmdbkafka2zabbix",
        "Direction": "dead-letter",
        "Description": "Rejected CMDBuild webhook events"
      },
      {
        "Name": "zabbix.host.requests.dlq",
        "Service": "zabbixrequests2api",
        "Direction": "dead-letter",
        "Description": "Rejected Zabbix host requests"
      },
      {
        "Name": "cmdbwebhooks2kafka.logs",
        "Service": "cmdbwebhooks2kafka",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "cmdbkafka2zabbix.logs",
        "Service": "cmdbkafka2zabbix",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "zabbixrequests2api.logs",
        "Service": "zabbixrequests2api",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "zabbixbindings2cmdbuild.logs",
        "Service": "zabbixbindings2cmdbuild",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "monitoring-ui-api.logs",
        "Service": "monitoring-ui-api",
        "Direction": "logs",
        "Description": "Structured logs"
      }
    ]
  },
  "QueueMonitor": {
    "Enabled": false,
    "RefreshIntervalMs": 5000,
    "WarningThreshold": 1000,
    "CriticalThreshold": 10000,
    "Pipelines": [
      {
        "Name": "Conversion queue",
        "Topic": "cmdbuild.webhooks",
        "Mode": "Lag",
        "StateFilePath": "../cmdbkafka2zabbix/state/cmdbkafka2zabbix-state.json"
      },
      {
        "Name": "Zabbix apply queue",
        "Topic": "zabbix.host.requests",
        "Mode": "Lag",
        "StateFilePath": "../zabbixrequests2api/state/zabbixrequests2api-state.json"
      },
      {
        "Name": "CMDBuild webhook DLQ",
        "Topic": "cmdbuild.webhooks.dlq",
        "Mode": "TopicDepth",
        "WarningThreshold": 1,
        "CriticalThreshold": 10
      },
      {
        "Name": "Zabbix request DLQ",
        "Topic": "zabbix.host.requests.dlq",
        "Mode": "TopicDepth",
        "WarningThreshold": 1,
        "CriticalThreshold": 10
      }
    ]
  },
  "Services": {
    "HealthEndpoints": []
  }
}
