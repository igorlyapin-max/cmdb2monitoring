{
  "Service": {
    "Name": "monitoring-ui-api-dev",
    "Port": 5090
  },
  "Transport": {
    "Mode": "Http"
  },
  "Auth": {
    "UseIdp": false
  },
  "Idp": {
    "Enabled": false,
    "AcsUrl": "http://localhost:5090/auth/saml2/acs",
    "SloCallbackUrl": "http://localhost:5090/auth/saml2/logout"
  },
  "AuditStorage": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=state/audit-dev.sqlite",
    "Schema": "",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30
  },
  "Cmdbuild": {
    "Webhooks": {
      "AuthorizationHeader": ""
    }
  },
  "EventBrowser": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "monitoring-ui-api-events-dev",
    "SecurityProtocol": "Plaintext",
    "SaslMechanism": "",
    "Username": "",
    "Password": "",
    "SslRejectUnauthorized": true,
    "MaxMessages": 50,
    "ReadTimeoutMs": 2500,
    "Topics": [
      {
        "Name": "cmdbuild.webhooks.dev",
        "Service": "cmdbwebhooks2kafka",
        "Direction": "output",
        "Description": "Normalized CMDBuild webhook events"
      },
      {
        "Name": "zabbix.host.requests.dev",
        "Service": "cmdbkafka2zabbix",
        "Direction": "output",
        "Description": "Zabbix JSON-RPC requests"
      },
      {
        "Name": "zabbix.host.responses.dev",
        "Service": "zabbixrequests2api",
        "Direction": "output",
        "Description": "Zabbix API processing responses"
      },
      {
        "Name": "zabbix.host.bindings.dev",
        "Service": "zabbixrequests2api",
        "Direction": "output",
        "Description": "Zabbix host binding events for CMDBuild back-sync"
      },
      {
        "Name": "cmdbuild.webhooks.dlq.dev",
        "Service": "cmdbkafka2zabbix",
        "Direction": "dead-letter",
        "Description": "Rejected CMDBuild webhook events"
      },
      {
        "Name": "zabbix.host.requests.dlq.dev",
        "Service": "zabbixrequests2api",
        "Direction": "dead-letter",
        "Description": "Rejected Zabbix host requests"
      },
      {
        "Name": "cmdbwebhooks2kafka.logs.dev",
        "Service": "cmdbwebhooks2kafka",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "cmdbkafka2zabbix.logs.dev",
        "Service": "cmdbkafka2zabbix",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "zabbixrequests2api.logs.dev",
        "Service": "zabbixrequests2api",
        "Direction": "logs",
        "Description": "Structured logs"
      },
      {
        "Name": "zabbixbindings2cmdbuild.logs.dev",
        "Service": "zabbixbindings2cmdbuild",
        "Direction": "logs",
        "Description": "Structured logs"
      }
    ]
  },
  "QueueMonitor": {
    "Enabled": true,
    "RefreshIntervalMs": 5000,
    "WarningThreshold": 1000,
    "CriticalThreshold": 10000,
    "Pipelines": [
      {
        "Name": "Конвертация CMDBuild -> Zabbix",
        "Topic": "cmdbuild.webhooks.dev",
        "Mode": "Lag",
        "StateFilePath": "../cmdbkafka2zabbix/state/cmdbkafka2zabbix-state.dev.json"
      },
      {
        "Name": "Применение в Zabbix",
        "Topic": "zabbix.host.requests.dev",
        "Mode": "Lag",
        "StateFilePath": "../zabbixrequests2api/state/zabbixrequests2api-state.dev.json"
      },
      {
        "Name": "DLQ вебхуков CMDBuild",
        "Topic": "cmdbuild.webhooks.dlq.dev",
        "Mode": "TopicDepth",
        "WarningThreshold": 1,
        "CriticalThreshold": 10
      },
      {
        "Name": "DLQ применения Zabbix",
        "Topic": "zabbix.host.requests.dlq.dev",
        "Mode": "TopicDepth",
        "WarningThreshold": 1,
        "CriticalThreshold": 10
      }
    ]
  },
  "Services": {
    "HealthEndpoints": [
      {
        "Name": "cmdbwebhooks2kafka",
        "Url": "http://localhost:5080/health"
      },
      {
        "Name": "cmdbkafka2zabbix",
        "Url": "http://localhost:5081/health",
        "RulesReloadUrl": "http://localhost:5081/admin/reload-rules",
        "RulesReloadToken": "dev-rules-reload-token",
        "RulesStatusUrl": "http://localhost:5081/admin/rules-status",
        "RulesStatusToken": "dev-rules-reload-token"
      },
      {
        "Name": "zabbixrequests2api",
        "Url": "http://localhost:5082/health"
      },
      {
        "Name": "zabbixbindings2cmdbuild",
        "Url": "http://localhost:5083/health"
      }
    ]
  }
}
