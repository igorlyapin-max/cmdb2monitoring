REGISTRY=localhost:5000
VERSION=0.8.2

ALLOWED_HOSTS=cmdb2monitoring.example.local
CMDBWEBHOOKS_BIND=127.0.0.1
CMDBWEBHOOKS_PORT=5080
MONITORING_UI_BIND=127.0.0.1
MONITORING_UI_PORT=5090

DOCKER_LOG_DRIVER=syslog
SYSLOG_ADDRESS=udp://127.0.0.1:514

DEBUG_LOGGING_ENABLED=false
DEBUG_LOGGING_LEVEL=Basic
LOG_MINIMUM_LEVEL=Information

SECRETS_PROVIDER=None
PAMURL=
PAMTOKEN=
PAMUSERNAME=
PAMPASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka01.example.local:9093,kafka02.example.local:9093
KAFKA_SECURITY_PROTOCOL=SaslSsl
KAFKA_SASL_MECHANISM=Plain
ALLOW_PLAINTEXT_KAFKA=false
SASLUSERNAME=REPLACE_KAFKA_SASL_USERNAME
SASLPASSWORD=REPLACE_KAFKA_SASL_PASSWORD
SASLPASSWORDSECRET=

CMDB_WEBHOOK_BEARER_TOKEN=REPLACE_CMDB_WEBHOOK_BEARER_TOKEN
RULES_RELOAD_TOKEN=REPLACE_RULES_RELOAD_TOKEN
RULES_STATUS_TOKEN=
RULES_HOST_PATH=/opt/cmdb2monitoring/rules

CMDBUILD_BASE_URL=https://cmdbuild.example.local/cmdbuild/services/rest/v4
CMDBUILD_API_VERSION=v4
CMDBUILD_USERNAME=REPLACE_CMDBUILD_READER_USERNAME
CMDBUILD_PASSWORD=REPLACE_CMDBUILD_READER_PASSWORD
CMDBUILD_WRITEBACK_USERNAME=REPLACE_CMDBUILD_WRITER_USERNAME
CMDBUILD_WRITEBACK_PASSWORD=REPLACE_CMDBUILD_WRITER_PASSWORD

ZABBIX_API_ENDPOINT=https://zabbix.example.local/api_jsonrpc.php
ZABBIX_AUTH_MODE=Token
ZABBIX_API_TOKEN=REPLACE_ZABBIX_API_TOKEN

AUDIT_STORAGE_PROVIDER=postgresql
AUDIT_STORAGE_CONNECTION_STRING=REPLACE_AUDIT_STORAGE_CONNECTION_STRING

MONITORING_UI_SESSION_STORE_MODE=Memory
MONITORING_UI_SESSION_ENCRYPTION_KEY=
