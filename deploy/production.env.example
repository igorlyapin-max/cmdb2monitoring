REGISTRY=localhost:5000
VERSION=0.8.2

ALLOWED_HOSTS=cmdb2monitoring.example.local
CMDBWEBHOOKS_BIND=127.0.0.1
CMDBWEBHOOKS_PORT=5080
MONITORING_UI_BIND=127.0.0.1
MONITORING_UI_PORT=5090

DOCKER_LOG_DRIVER=syslog
SYSLOG_ADDRESS=udp://127.0.0.1:514

DEBUG_LOGGING_ENABLED=false
DEBUG_LOGGING_LEVEL=Basic
LOG_MINIMUM_LEVEL=Information

SECRETS_PROVIDER=IndeedPamAapm
PAMURL=https://pam.example.local
PAMTOKEN=
PAMUSERNAME=
PAMPASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka01.example.local:9093,kafka02.example.local:9093
KAFKA_SECURITY_PROTOCOL=SaslSsl
KAFKA_SASL_MECHANISM=Plain
ALLOW_PLAINTEXT_KAFKA=false
SASLUSERNAME=cmdb2monitoring-kafka
SASLPASSWORD=
SASLPASSWORDSECRET=AAA.LOCAL\PROD.kafka-sasl

CMDB_WEBHOOK_BEARER_TOKEN=secret://AAA.LOCAL\PROD.cmdb-webhook-token
RULES_RELOAD_TOKEN=secret://AAA.LOCAL\PROD.rules-reload-token
RULES_STATUS_TOKEN=
RULES_HOST_PATH=/opt/cmdb2monitoring/rules

CMDBUILD_BASE_URL=https://cmdbuild.example.local/cmdbuild/services/rest/v3
CMDBUILD_USERNAME=cmdb2monitoring-reader
CMDBUILD_PASSWORD=secret://AAA.LOCAL\PROD.cmdb-reader-password
CMDBUILD_WRITEBACK_USERNAME=cmdb2monitoring-writer
CMDBUILD_WRITEBACK_PASSWORD=secret://AAA.LOCAL\PROD.cmdb-writer-password

ZABBIX_API_ENDPOINT=https://zabbix.example.local/api_jsonrpc.php
ZABBIX_AUTH_MODE=Token
ZABBIX_API_TOKEN=secret://AAA.LOCAL\PROD.zabbix-api-token

AUDIT_STORAGE_PROVIDER=postgresql
AUDIT_STORAGE_CONNECTION_STRING=secret://AAA.LOCAL\PROD.audit-storage-connection

MONITORING_UI_SESSION_STORE_MODE=Memory
MONITORING_UI_SESSION_ENCRYPTION_KEY=
